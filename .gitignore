# ============================================================
#  敏感文件 —— 绝对不入库
#  （本仓库为公开仓库，以下文件含明文口令/令牌，一旦推送即等于公开）
# ============================================================
密码信息.md
config.php
scripts/push_client.config.php
.workbuddy/

# ============================================================
#  用户内容 —— 文章配图属站点运行时资源，不随代码分发
#  （保留 .htaccess 以便 uploads 目录在仓库中存在）
# ============================================================
public/assets/uploads/*
!public/assets/uploads/.htaccess

# 视频上传目录（用户内容，不随代码分发；保留 .htaccess 以便目录在仓库中存在）
public/assets/videos/*
!public/assets/videos/.htaccess

# ============================================================
#  运行期产物与系统文件
# ============================================================
*.log
_tmp/
*.bak
*.tmp

# Windows / macOS
Thumbs.db
Desktop.ini
.DS_Store

# 编辑器
.idea/
.vscode/
*.swp
